# Copy this file to .env and fill in your values. .env is ignored by git.

# Airwallex sandbox: sandbox.airwallex.com > Account > Developer > API keys
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=

# Claude API (powers Warden's risk check): platform.claude.com > API Keys
ANTHROPIC_API_KEY=

# Metal testnet RPC endpoint: console-testnet.metalntwx.com > Endpoints
METAL_RPC_URL=

# Optional. Leave blank to use the defaults.
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# Pin an API version if a call fails with an unknown-field error, e.g. 2026-08-21
AIRWALLEX_API_VERSION=
